# Copy this to .streamlit/secrets.toml and fill in your values
# DO NOT commit secrets.toml to git!

# AWS Credentials (from your personal AWS account)
AWS_ACCESS_KEY_ID = "YOUR_ACCESS_KEY_HERE"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_KEY_HERE"
AWS_DEFAULT_REGION = "us-east-1"

# ElevenLabs (optional - for voice)
ELEVENLABS_API_KEY = "YOUR_ELEVENLABS_KEY_HERE"

# Knowledge Base IDs (create these in your personal AWS account)
KB_ID_515 = "YOUR_KB_ID_HERE"
KB_ID_512 = "YOUR_KB_ID_HERE"
