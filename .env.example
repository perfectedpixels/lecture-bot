# Optional: ElevenLabs for voice (if using)
# ELEVENLABS_API_KEY=your_key_here
# ELEVENLABS_VOICE_ID=your_voice_id

# Canvas LMS API (for live assignment sync + the API's homework-help feature)
# Generate token: Canvas → Account → Settings → Approved Integrations → + New Access Token
# Tokens expire — Canvas emails a warning before expiry, but if homework-help
# starts 401ing, regenerate this.
# CANVAS_API_TOKEN=your_canvas_token_here
# CANVAS_BASE_URL=https://canvas.uw.edu
# Comma-separated course IDs used by scripts/canvas_sync.py for bulk KB
# ingestion. api/main.py's live homework-help widget (GET /api/assignments/upcoming,
# POST /api/chat's assignment_id) also reads this list and uses the FIRST id
# as "the active course" — there is no separate single-course env var.
# CANVAS_COURSE_IDS=12345,67890

# MCP (Model Context Protocol) server — exposes the lecture KB to external
# agents/tools over Streamable HTTP at /api/mcp. Required to mount that
# endpoint at all: if unset, api/main.py skips mounting it entirely (fails
# closed, never serves it unauthenticated). Generate your own secret, e.g.:
#   openssl rand -hex 32
# MCP_API_KEY=your_generated_secret_here

# Second, SEPARATE credential for the path-based MCP mount at
# /api/mcp/u/<MCP_URL_TOKEN>/. This exists only because claude.ai's "Add
# custom connector" dialog takes a URL and OAuth client credentials but has no
# field for an Authorization header, so the bearer endpoint above is unusable
# from there. Here the unguessable path segment IS the credential.
#
# A token in a URL is exposed in more places than one in a header (browser
# history, proxy/access logs, the connector settings screen), so keep this
# value DIFFERENT from MCP_API_KEY — main.py refuses to mount if they match,
# or if this is under 32 chars — and rotate it independently. Unset means the
# mount is skipped entirely. Generate with:
#   openssl rand -hex 24
# MCP_URL_TOKEN=your_generated_url_token_here
