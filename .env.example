# AWS Credentials (perfectpixels-bot user with Bedrock permissions)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Bedrock Knowledge Base
KNOWLEDGE_BASE_ID=HHYCUJH32J
DATA_SOURCE_ID=IIQK0FNCTC

# S3 Configuration
S3_BUCKET=lecture-transcripts-427791004700
S3_PREFIX=lectures_processed

# Bot Configuration
PERSONA_NAME=Jason Levine
USE_HAIKU=true
ENABLE_CACHE=true

# Optional: ElevenLabs for voice (if using)
# ELEVENLABS_API_KEY=your_key_here
# ELEVENLABS_VOICE_ID=your_voice_id

# Canvas LMS API (for live assignment sync + the API's homework-help feature)
# Generate token: Canvas → Account → Settings → Approved Integrations → + New Access Token
# Tokens expire — Canvas emails a warning before expiry, but if homework-help
# starts 401ing, regenerate this.
# CANVAS_API_TOKEN=your_canvas_token_here
# CANVAS_BASE_URL=https://canvas.uw.edu
# Comma-separated course IDs used by scripts/canvas_sync.py for bulk KB
# ingestion. api/main.py's live homework-help widget (GET /api/assignments/upcoming,
# POST /api/chat's assignment_id) also reads this list and uses the FIRST id
# as "the active course" — there is no separate single-course env var.
# CANVAS_COURSE_IDS=12345,67890
